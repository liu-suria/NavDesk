# Add these two values in EdgeOne Makers → Environment variables / Secrets.
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=use-a-random-string-with-at-least-32-characters
# Optional: reuse an existing HomeLedger API key on the server only.
# Without it, the user connects using the HomeLedger password in the panel.
HOMELEDGER_API_KEY=
